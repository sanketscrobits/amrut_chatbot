# =========================
# General
# =========================
PYTHONUTF8=1
ORGANIZATION_NAME=your-organization-name
NAMESPACE=your-namespace

# =========================
# Google / Gemini
# =========================
GEMINI_API_KEY=your-gemini-api-key

# =========================
# Pinecone
# =========================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_REGION=us-east-1
PINECONE_HOST=https://your-pinecone-host.pinecone.io

# =========================
# Guardrails
# =========================
GUARDRAILS_API_KEY=your-guardrails-api-key

# =========================
# LangSmith / LangChain
# =========================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=your-langsmith-project-name

# =========================
# CUDA
# =========================
CUDA_VISIBLE_DEVICES=""

# =========================
# Supabase Database
# =========================
SUPABASE_DATABASE_URI=postgresql://user:password@host:5432/database
SUPABASE_DB_HOST=your-db-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=your-db-name
SUPABASE_DB_USER=your-db-user
SUPABASE_DB_PASSWORD=your-db-password

# =========================
# Weather API
# =========================
OPENWEATHER_API_KEY=your-openweather-api-key

# =========================
# Other APIs
# =========================
X_API_KEY=your-x-api-key
