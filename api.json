{
    "info": {
        "_postman_id": "amrut-chatbot-api-collection",
        "name": "Amrut Chatbot API",
        "description": "API collection for Amrut Chatbot including Chat, Document Upload, and Management endpoints. Updated with validation scenarios.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "General",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                ""
                            ]
                        },
                        "description": "Verify API is running."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Chatbot",
            "item": [
                {
                    "name": "Send Message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"user_message\": \"tell me the tourist highlights in gondia?\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/chatbot",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "chatbot"
                            ]
                        },
                        "description": "Main chat endpoint. Returns AI response and potential escalation details."
                    },
                    "response": []
                },
                {
                    "name": "Send Message (Empty - Validation Error)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"user_message\": \"   \"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/chatbot",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "chatbot"
                            ]
                        },
                        "description": "Tests validation for empty messages. Expects 422 Unprocessable Entity."
                    },
                    "response": []
                },
                {
                    "name": "Delete Document (by UUID)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/chatbot/delete/{{test_uuid}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "chatbot",
                                "delete",
                                "{{test_uuid}}"
                            ]
                        },
                        "description": "Deletes all vector chunks associated with a specific Source UUID."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Document Management",
            "item": [
                {
                    "name": "Upload Document",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "file",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/upload/{{test_uuid}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "upload",
                                "{{test_uuid}}"
                            ]
                        },
                        "description": "Upload a document (PDF, TXT, MD, etc.) to be ingested into the vector database. Max size 10MB."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Escalation",
            "item": [
                {
                    "name": "User WebSocket (Browser Only)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{ws_url}}/ws/escalation/{{escalation_id}}/user",
                            "host": [
                                "{{ws_url}}"
                            ],
                            "path": [
                                "ws",
                                "escalation",
                                "{{escalation_id}}",
                                "user"
                            ]
                        },
                        "description": "WebSocket endpoint for user chat during escalation. Connect via separate WebSocket client."
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "ws_url",
            "value": "ws://localhost:8000",
            "type": "string"
        },
        {
            "key": "test_uuid",
            "value": "test-doc-123",
            "type": "string"
        },
        {
            "key": "escalation_id",
            "value": "sample-escalation-id",
            "type": "string"
        }
    ]
}
